<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="ni.edu.uam.practicahilo.ProcesadorController"
      alignment="CENTER"
      spacing="15"
      prefWidth="520"
      prefHeight="580">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <!-- TÍTULO PRINCIPAL -->
    <Label text="Procesador de registros"
           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <Separator prefWidth="420"/>

    <!-- SECCIÓN 1: CLIENTES (100 REGISTROS) -->
    <Label text="Proceso de Clientes (100 registros)"
           style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <Label fx:id="lblEstadoClientes"
           text="Esperando inicio"/>

    <ProgressBar fx:id="barraClientes"
                 progress="0"
                 prefWidth="420"/>

    <Label fx:id="lblPorcentajeClientes"
           text="0%"/>

    <HBox alignment="CENTER" spacing="10">
        <Button fx:id="btnIniciarClientes"
                text="Iniciar"
                onAction="#iniciarClientes"/>

        <Button fx:id="btnDetenerClientes"
                text="Detener"
                onAction="#detenerClientes"
                disable="true"/>

        <Button fx:id="btnReiniciarClientes"
                text="Reiniciar"
                onAction="#reiniciarClientes"/>
    </HBox>

    <Separator prefWidth="420"/>

    <Label text="Proceso de Productos (50 registros)"
           style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <Label fx:id="lblEstadoProductos"
           text="Esperando inicio"/>

    <ProgressBar fx:id="barraProductos"
                 progress="0"
                 prefWidth="420"/>

    <Label fx:id="lblPorcentajeProductos"
           text="0%"/>

    <HBox alignment="CENTER" spacing="10">
        <Button fx:id="btnIniciarProductos"
                text="Iniciar"
                onAction="#iniciarProductos"/>

        <Button fx:id="btnDetenerProductos"
                text="Detener"
                onAction="#detenerProductos"
                disable="true"/>

        <Button fx:id="btnReiniciarProductos"
                text="Reiniciar"
                onAction="#reiniciarProductos"/>
    </HBox>

</VBox>